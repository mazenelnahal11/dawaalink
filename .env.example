# DawaaLink Environment Configuration
# Copy this file to .env and fill in real values. NEVER commit .env to version control.

# ─── Database ───
POSTGRES_USER=dawaalink_user
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=dawaalink
DB_HOST_PORT=5434

# ─── JWT ───
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48

# ─── Spring Profile ───
# Use 'dev' locally (enables Swagger), 'prod' in production (disables Swagger)
SPRING_PROFILES_ACTIVE=dev
