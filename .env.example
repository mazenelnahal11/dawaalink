# DawaaLink Environment Configuration
# Copy to .env for local dev. NEVER commit .env to version control.
# For Railway: set these in each service's Variables panel.

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=dawaalink_user
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=dawaalink
DB_HOST_PORT=5434

# Spring datasource
# Local:   jdbc:postgresql://localhost:5434/dawaalink
# Railway: jdbc:postgresql://${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/dawaalink
SPRING_DATASOURCE_USERNAME=dawaalink_user
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ─── Security ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48

# ─── Spring ──────────────────────────────────────────────────────────────────
# Use 'dev' locally (enables Swagger), 'prod' in production
SPRING_PROFILES_ACTIVE=dev

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_key_here
# Base URL used in email reset/welcome links — set to your Railway frontend public URL
APP_FRONTEND_BASE_URL=http://localhost

# ─── Admin bootstrap (runs once on first startup if no ADMIN exists) ─────────
APP_ADMIN_BOOTSTRAP_EMAIL=admin@yourdomain.com
APP_ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# ─── Frontend nginx proxy target ─────────────────────────────────────────────
# Local (docker-compose):  http://backend:8080
# Railway frontend service: http://${{backend.RAILWAY_PRIVATE_DOMAIN}}
BACKEND_URL=http://backend:8080

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost
